# Шаблон для заголовков безопасности (Применяем для сайта и Прометея)
(security_headers) {
    header {
        X-Frame-Options "DENY"
        Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline';"
        X-Content-Type-Options "nosniff"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }
}

# 1. Основной сайт (Резюме) — Защита включена
starostsenko.xyz, www.starostsenko.xyz {
    reverse_proxy app:8080
    import security_headers
}

# 2. Мониторинг Grafana — Без внешнего CSP (Графана защищает себя сама)
grafana.starostsenko.xyz {
    reverse_proxy grafana:3000
    
    # Для Графаны оставляем только HSTS, чтобы принудительно работал HTTPS
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }
}

# 3. Безопасный Prometheus (Доступ только для вас) — Защита включена
prometheus.starostsenko.xyz {
    basic_auth {
        admin $2a$14$3I8qATlZqA7qnM6zU1cInOBegaSIV4lAnSqxuczpMFUfGGId4khey
    }
    reverse_proxy prometheus:9090
    import security_headers
}
